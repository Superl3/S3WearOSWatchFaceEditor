{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo2wff.local/schemas/scene.schema.json",
  "title": "Photo2WFF Scene",
  "description": "Canonical, editable representation of one normalized 438x438 Wear OS watch face.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canvas", "normalization", "background", "elements", "analysis"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "normalization": { "$ref": "#/$defs/normalization" },
    "background": { "$ref": "#/$defs/background" },
    "clock": { "$ref": "#/$defs/clock" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "normalized": { "type": "boolean" },
        "sourceSize": { "$ref": "#/$defs/size" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": { "type": "string" },
        "date": { "type": "string" },
        "weekday": { "type": "string" },
        "battery": { "type": "integer", "minimum": 0, "maximum": 100 },
        "steps": { "type": "integer", "minimum": 0 },
        "heartRate": { "type": "integer", "minimum": 0, "maximum": 240 }
      }
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    },
    "analysis": { "$ref": "#/$defs/analysis" }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "size": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 438 },
        "y": { "type": "number", "minimum": 0, "maximum": 438 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 438 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 438 }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "shape", "centerX", "centerY"],
      "properties": {
        "width": { "const": 438 },
        "height": { "const": 438 },
        "shape": { "const": "CIRCLE" },
        "centerX": { "const": 219 },
        "centerY": { "const": 219 }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "centerX", "centerY", "confidence"],
      "properties": {
        "type": { "const": "ANALOG" },
        "centerX": { "type": "number", "minimum": 0, "maximum": 438 },
        "centerY": { "type": "number", "minimum": 0, "maximum": 438 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string" }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputType", "rotationDegrees", "confidence", "requiresPerspectiveCorrection"],
      "properties": {
        "inputType": { "enum": ["SCREENSHOT", "PHOTOGRAPH", "CROPPED_SCREEN", "UNCERTAIN"] },
        "rotationDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "requiresPerspectiveCorrection": { "type": "boolean" },
        "sourceSize": { "$ref": "#/$defs/size" },
        "displayBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "background": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "color"],
          "properties": { "type": { "const": "SOLID" }, "color": { "$ref": "#/$defs/color" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "colors"],
          "properties": {
            "type": { "enum": ["LINEAR_GRADIENT", "RADIAL_GRADIENT"] },
            "colors": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/color" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "IMAGE" },
            "asset": { "type": "string" },
            "resourceHint": { "type": "string" }
          },
          "anyOf": [{ "required": ["asset"] }, { "required": ["resourceHint"] }]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "UNKNOWN" }, "uncertainty": { "type": "array", "items": { "type": "string" } } }
        }
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontWeight": { "type": "number", "minimum": 100, "maximum": 900 },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "letterSpacing": { "type": "number" },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "alignment": { "enum": ["left", "center", "right", "LEFT", "CENTER", "RIGHT"] },
        "color": { "$ref": "#/$defs/color" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 255 },
        "strokeWidth": { "type": "number", "minimum": 0 }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "dynamic", "bbox", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "type": { "enum": ["TIME", "HOUR", "MINUTE", "SECOND", "DATE", "WEEKDAY", "TEXT", "BATTERY", "STEPS", "HEART_RATE", "COMPLICATION", "ICON", "IMAGE", "STATIC_IMAGE", "ANALOG_HAND", "RING", "LINE", "RECTANGLE", "CIRCLE"] },
        "dynamic": { "type": "boolean" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "format": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "text": { "type": "string" },
        "asset": { "type": "string" },
        "assetInstruction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation"],
          "properties": { "operation": { "const": "extract_from_reference" } }
        },
        "dataSource": { "type": "string" },
        "role": { "enum": ["HOUR", "MINUTE", "SECOND"] },
        "observedAngleDeg": { "type": "number", "minimum": -360, "maximum": 360 },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "pivotX": { "type": "number", "minimum": 0, "maximum": 1 },
        "pivotY": { "type": "number", "minimum": 0, "maximum": 1 },
        "zIndex": { "type": "integer" },
        "sweepFrequency": { "type": "number", "exclusiveMinimum": 0 },
        "launch": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "relationships": { "type": "object" },
        "uncertainty": { "type": "array", "items": { "type": "string" } }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watchFaceCategory", "overallConfidence", "requiresStaticAssetExtraction", "requiresHumanReview"],
      "properties": {
        "watchFaceCategory": { "enum": ["MINIMAL_DIGITAL", "MINIMAL_ANALOG"] },
        "overallConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "requiresStaticAssetExtraction": { "type": "boolean" },
        "requiresHumanReview": { "type": "boolean" },
        "method": { "type": "string" },
        "componentCount": { "type": "integer", "minimum": 0 },
        "groupCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
